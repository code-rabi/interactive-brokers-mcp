{
  "name": "interactive-brokers-mcp",
  "version": "1.0.0",
  "description": "MCP server for Interactive Brokers API integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ib-mcp": "dist/index.js"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist/**/*",
    "dependencies.manifest.json",
    "install/**/*",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && echo '#!/usr/bin/env node' | cat - dist/index.js > temp && mv temp dist/index.js && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "start:http": "MCP_HTTP_SERVER=true node dist/index-http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "MCP_HTTP_SERVER=true tsx src/index-http.ts",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "oxlint src/ --config=./.oxlintrc.json",
    "lint:fix": "oxlint src/ --config=./.oxlintrc.json --fix",
    "audit": "npm audit --omit=dev",
    "manifest:update": "node scripts/update-dependency-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "inspector": "npx @modelcontextprotocol/inspector --config mcp-inspector.json --server interactive-brokers-mcp"
  },
  "keywords": [
    "mcp",
    "interactive-brokers",
    "trading",
    "api"
  ],
  "author": "Nitay Rabinovich",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-rabi/interactive-brokers-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/code-rabi/interactive-brokers-mcp/issues"
  },
  "homepage": "https://github.com/code-rabi/interactive-brokers-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "adm-zip": "^0.5.17",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.22.2",
    "open": "^10.2.0",
    "otpauth": "^9.5.1",
    "playwright-core": "^1.54.2",
    "undici": "^7.0.0",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.19.22",
    "@types/xml2js": "^0.4.14",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "oxlint": "^1.66.0",
    "semantic-release": "^25.0.5",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0",
    "vitest": "^4.1.9"
  }
}
